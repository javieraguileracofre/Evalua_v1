# Copiar a .env y completar valores reales. No commitear secretos.

# Desarrollo local (recomendado): solo esta PC.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
# LAN / móvil: UVICORN_HOST=0.0.0.0 requiere SECRET_KEY fuerte (>=32 aleatorios).

APP_NAME=EvaluaERP
APP_ENV=development
# APP_DEBUG hereda de APP_ENV; en producción queda false si no se define.
# APP_DEBUG=false
APP_VERSION=1.0.0
LOG_LEVEL=INFO
# Obligatorio: openssl rand -hex 32  (nunca valores del producto ni "cambia-esto").
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Cookie Secure: en HTTPS deje true. En http://127.0.0.1 deje false o no defina.
# AUTH_COOKIE_SECURE=true
# AUTH_SESSION_MAX_AGE_SECONDS=28800
# DB_CONNECT_TIMEOUT_SECONDS=10
# Hosts HTTP permitidos (TrustedHost). En Render agregue su dominio.
# ALLOWED_HOSTS=localhost,127.0.0.1,testserver,su-app.onrender.com
# TRUST_X_FORWARDED_FOR=true  # solo detrás de proxy de confianza (Render/nginx)

# Opción A: URLs completas (recomendado si ya las tiene).
DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/nombre_bd
PLATFORM_DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/plataforma
#
# Producción: APP_ENV=production, APP_DEBUG=false, AUTH_COOKIE_SECURE=true,
# SECRET_KEY con openssl rand -hex 32, ALLOWED_HOSTS con el FQDN real.

# Opción B: variables sueltas (si no define DATABASE_URL, se arma la URL automáticamente).
# DB_USER=evalua_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=evaluaerp_db
# DB_SSLMODE=require

# TENANCY_MODE=legacy conserva DATABASE_URL. database_per_company no la usa como fallback.
TENANCY_MODE=legacy
# IDENTITY_DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/erp_identity
# ADMIN_POSTGRES_URL=postgresql+psycopg://postgres:clave@localhost:5432/postgres
# DB_CREDENTIALS_KEY=
#
# Schema: en producción dejar false. Migrar con:
#   legacy → python tools/upgrade_company_schema.py --legacy
#   company → python tools/upgrade_company_schema.py --status|--all|--company CODE
# AUTO_MIGRATE_ON_STARTUP=false
# (solo desarrollo local, nunca en producción / Render)
TENANT_HEADER_NAME=X-Tenant-Code
TENANT_QUERY_PARAM=tenant
TENANT_COOKIE_NAME=tenant_code

# Bootstrap admin (nunca deje una clave fija en Git):
# EVALUA_BOOTSTRAP_ADMIN_EMAIL=admin@empresa.cl
# EVALUA_BOOTSTRAP_ADMIN_PASSWORD=
# EVALUA_BOOTSTRAP_ADMIN_NAME=Administrador
# Alternativa: python tools/create_admin_user.py --email ... --password ...

# FONDO_RENDIR_CUENTA_ANTICIPO=1.1.05
# FONDO_RENDIR_CUENTA_CAJA=1.1.01
# FONDO_RENDIR_CUENTA_GASTO=6.1.01

# REMUNERACION_CUENTA_SUELDOS_POR_PAGAR=210101
# REMUNERACION_CUENTA_BANCO=110201
# REMUNERACION_CUENTA_GASTO_SUELDOS=610104

LOP_COMERCIAL_V2=true

# Cloudflare Tunnel (solo consulta de estado desde Administración → Estado del sistema).
# No ponga tokens ni credenciales aquí.
# CLOUDFLARE_SERVICE_NAME=Cloudflared
# CLOUDFLARE_TUNNEL_NAME=evaluaerp
# CLOUDFLARE_HOSTNAME=gaval.evaluasoluciones.cl
# CLOUDFLARE_ORIGIN=http://localhost:4000

# OAuth correo (opcional). Si se definen, la UI puede ofrecer «Conectar con Google / Microsoft».
# Sin estos valores, use SMTP con contraseña de aplicación cifrada.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=

# EVALUA_SMTP_HOST=
# EVALUA_SMTP_PORT=465
# EVALUA_SMTP_USER=
# EVALUA_SMTP_PASSWORD=
# EVALUA_MAIL_FROM_NAME=Evalua ERP
# EVALUA_MAIL_REPLY_TO=
# MAIL_CREDENTIALS_KEY=
